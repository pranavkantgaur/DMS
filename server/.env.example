PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=dms_db
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# ── PDF → AutoCAD Conversion (vllm) ─────────────────────────────────────────
# Base URL of the on-premise vllm server (OpenAI-compatible endpoint)
VLLM_BASE_URL=http://localhost:8000/v1
# Vision-capable model loaded by vllm (must support image input)
VLLM_MODEL=llava-hf/llava-v1.6-mistral-7b-hf
# Optional API key (leave blank if vllm is running without authentication)
VLLM_API_KEY=
# Request timeout in milliseconds for the VLM call (default: 120 s)
VLLM_TIMEOUT_MS=120000
# Maximum tokens to generate in the VLM response (default: 4096)
VLLM_MAX_TOKENS=4096
